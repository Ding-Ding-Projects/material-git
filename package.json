{
  "name": "material-git",
  "productName": "Material Git",
  "version": "0.1.0",
  "description": "A Material Design desktop workspace for GitHub CLI",
  "author": "Ding-Ding-Projects",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "catalog": "node scripts/catalog.mjs",
    "fetch-dependencies": "node scripts/fetch-dependencies.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.3.0",
    "@material/web": "2.5.0",
    "dompurify": "3.3.0",
    "lit": "3.3.2",
    "marked": "16.4.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@electron/packager": "19.0.1",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "electron": "44.7.0",
    "electron-winstaller": "5.4.0",
    "esbuild": "0.27.0",
    "playwright": "1.56.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
